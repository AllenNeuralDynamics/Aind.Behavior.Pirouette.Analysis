# Example parameters for scripts/build_dataset.py.
# Copy to `.env` and edit. CLI flags override any value set here.

# --- Paths (required) ---
POSE_DIR=/path/to/body-kinematics/pose_data
DATA_DIR=s3://aind-open-data/854393_2026-06-09_19-34-26
SAVE_DIR=/path/to/body-kinematics/datasets

# --- Pose / calibration ---
LIKELIHOOD_THRESHOLD=0.6
CHAMBER_LENGTH_MM=373
CHAMBER_WIDTH_MM=194

# --- Heading / velocity ---
FORWARD_SIGN=1            # flip to -1 if heading/velocity is 180 deg out
COMMUTATOR_DIRECTION=1    # flip to -1 if commutator heading runs backwards
SMOOTHING_SIGMA=1.5       # Gaussian sigma (frames) for velocity smoothing
VELOCITY_METHOD=signed_speed   # or "projection"

# --- Behaviour classification ---
MIN_BOUT_S=0.5           # minimum movement-bout duration (s)
BRIDGE_GAP_S=0.2         # bridge movement dips shorter than this (s)
LOG_OTSU=true            # log-scale Otsu threshold (captures slow movement)

# --- Output ---
OUTPUT_FORMAT=parquet    # parquet (default) or csv

# --- Visualization GUI (scripts/run_gui.py) ---
DATASET_DIR=/path/to/body-kinematics/datasets   # defaults to SAVE_DIR if unset
UNITS_DIR=/path/to/body-kinematics/units        # holds good_units.pkl
VIDEO_DIR=/path/to/body-kinematics/pose_videos  # <source_file>.mp4 files
SPIKE_OFFSET_S=0         # seconds added to spike times -> experiment reference
SHOW_ALL_SPIKES=false    # true = render every spike tick (slower); false = 40k subsample
FIRING_RATE_BIN_S=0.05   # firing-rate histogram bin width (s); larger = coarser/faster
FIRING_RATE_SMOOTH_S=0.2 # firing-rate Gaussian smoothing sigma (s)
HEADING_MODE=vector      # which heading to plot: vector, commutator, or both
CLEAR_CACHE_ON_EXIT=false # true = delete firing-rate caches when the GUI closes
#                           (default false: caches persist so restarts are instant)
GUI_HOST=0.0.0.0         # 0.0.0.0 = reachable on the LAN; 127.0.0.1 = this PC only
GUI_PORT=8050
# SHARE=true             # open a public link for remote viewers
# SHARE_METHOD=cloudflare  # cloudflare (quick, random URL, minutes-hours)
                           # | cloudflare-named (stable URL, lasts weeks)
                           # | ngrok
# --- Named Cloudflare tunnel: a stable URL that lasts weeks ---
# This project's canonical host is https://pirouette-viz.org.
# One-time setup (needs the domain on a free Cloudflare account):
#   cloudflared tunnel login
#   cloudflared tunnel create pirouette
#   cloudflared tunnel route dns pirouette pirouette-viz.org
# then set SHARE_METHOD=cloudflare-named and:
# CLOUDFLARE_TUNNEL=pirouette
# CLOUDFLARE_HOSTNAME=pirouette-viz.org
# NGROK_AUTHTOKEN=       # only needed if SHARE_METHOD=ngrok

# --- Spike-raster animation (scripts/raster_animation.py) ---
# Dataset: EPHYS_DATASET is the primary var; RASTER_UNITS_FILE and UNITS_DIR/good_units.pkl are fallbacks.
EPHYS_DATASET=/path/to/units/good_units_100hrs.pkl
# RASTER_UNITS_FILE=/path/to/good_units.pkl   # legacy fallback
RASTER_SAVE_DIR=/path/to/body-kinematics/animations  # where the file is written
RASTER_OUT=raster_animation.mp4  # file name (.mp4/.gif); bare name -> SAVE_DIR
# Starting time (centre of zoom). Default = middle of the recording.
# RASTER_START_TIME_S=180000     # new canonical name
# RASTER_CENTER_S=64800          # legacy alias (still accepted)
# Window: zoom from WINDOW_START to WINDOW_END.
# Scale-bar milestones shown during the zoom: 1 ms → 100 ms → 1 s → 1 min → 1 hr → 10 hrs → 100 hrs
RASTER_WINDOW_START_S=0.001      # initial window width (s); 0.001 = 1 ms
RASTER_WINDOW_END_S=360000       # final window (s); 360000 = 100 hrs
RASTER_DURATION_S=20             # wall-clock video length of the zoom (seconds of video, not recording time)
RASTER_HOLD_S=3                  # closing-card hold (s)
RASTER_FPS=30
RASTER_CAP=60000                 # max spikes drawn per frame (subsampled)
RASTER_DPI=120
RASTER_CMAP=muted                # palette: muted | rainbow | any mpl colormap name
RASTER_MODE=charlie              # charlie (dartsort-style scatter) | hybrid (ticks → heatmap)
# CHARLIE_MAX_SPIKES=500000      # global spike cap for charlie mode (default 500 000)
# Jitter density mode (charlie mode only):
#   per-unit (default) — each unit's spread scales by its own local firing density
#   global             — spread scales by total population spike density
#   none               — uniform jitter at full sigma, no density weighting
# CHARLIE_JITTER_DENSITY=none
# RASTER_INVERT_DEPTH=false      # flip if "highest at top" comes out upside-down
# Zoom smoothness
RASTER_EASING=ease-in-out        # linear | ease-in | ease-out | ease-in-out
RASTER_MILESTONE_DWELL_S=0.5     # seconds to hold at each scale-bar milestone (0 = no dwell)
# Axis unit switch thresholds: window width (seconds) at which tick labels change units
RASTER_AXIS_MS_TO_S=1.0          # switch ms → s  when window reaches this width
RASTER_AXIS_S_TO_MIN=100.0       # switch s  → min
RASTER_AXIS_MIN_TO_HR=6000.0     # switch min → hours  (6000 s = 100 min)

# --- S3 / misc ---
ANONYMOUS_S3=true        # unsigned access to the public open-data bucket
# MAX_FILES=             # optional: limit to first N pose files (blank = all)
